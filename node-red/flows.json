    "layout": "row-spread",
    "x": 850,
    "y": 200,
    "wires": []
  },
  {
    "id": "rssi-text",
    "type": "ui_text",
    "z": "tab-smartfeeder",
    "group": "dashboard-group",
    "order": 5,
    "width": 4,
    "height": 1,
    "name": "WiFi RSSI",
