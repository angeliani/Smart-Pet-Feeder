    "name": "Bowl Weight",
    "group": "dashboard-group",
    "order": 2,
    "width": 4,
    "height": 4,
    "gtype": "gage",
    "title": "Bowl Weight",
    "label": "g",
    "format": "{{value}}",
    "min": 0,
    "max": 1000,
    "colors": ["#1976d2","#388e3c","#d32f2f"],
    "seg1": 300,
    "seg2": 700,
    "x": 850,
    "y": 100,
    "wires": []
  },
  {
    "id": "distance-text",
