    "width": 4,
    "height": 1,
    "name": "Device Status",
    "label": "Device Status",
    "format": "{{msg.payload.device}} — {{msg.payload.status}}",
    "layout": "row-spread",
    "x": 600,
    "y": 430,
    "wires": []
  },
  {
    "id": "event-text",
    "type": "ui_text",
    "z": "tab-smartfeeder",
    "group": "dashboard-group",
    "order": 7,
    "width": 12,
    "height": 1,
    "name": "Last Feed Event",
    "label": "Last Feed Event",
    "format": "{{msg.payload.type}} — {{msg.payload.status}} — target {{msg.payload.target_g}} g — delivered {{msg.payload.delivered_g}} g",
    "layout": "row-spread",
    "x": 600,
    "y": 480,
    "wires": []
  },
  {
    "id": "telemetry-chart",
    "type": "ui_chart",
    "z": "tab-smartfeeder",
    "name": "Stock History",
    "group": "dashboard-group",
    "order": 8,
    "width": 12,
    "height": 5,
    "label": "Food Stock History",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for telemetry...",
    "dot": false,
    "ymin": "0",
    "ymax": "100",
    "removeOlder": "24",
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#009688"],
    "outputs": 1,
    "useDifferentColor": false,
    "className": "",
    "x": 850,
    "y": 300,
    "wires": [[]]
  },
  {
