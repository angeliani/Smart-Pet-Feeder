  { "id": "flow1", "type": "tab", "label": "Smart Pet Feeder", "disabled": false, "info": "Placeholder. Isi broker, lalu tambah node InfluxDB, dashboard, dan Telegram." },
  { "id": "tls1", "type": "tls-config", "name": "tls-broker", "cert": "", "key": "", "ca": "", "certname": "", "keyname": "", "caname": "", "servername": "", "verifyservercert": true },
