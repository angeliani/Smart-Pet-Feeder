[
  {
    "id": "tab-smartfeeder",
    "type": "tab",
    "label": "Smart Pet Feeder",
    "disabled": false,
    "info": "ESP32 -> MQTT TLS -> Node-RED -> MongoDB -> Dashboard/Alerts"
  },
  {
    "id": "mqtt-in-telemetry",
    "type": "mqtt in",
    "z": "tab-smartfeeder",
    "name": "Telemetry MQTT",
    "topic": "petfeeder/+/telemetry",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 80,
    "wires": [["parse-telemetry"]]
  },
  {
    "id": "parse-telemetry",
    "type": "function",
    "z": "tab-smartfeeder",
    "name": "Process Telemetry",
    "func": "let d = msg.payload;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { node.error('Invalid telemetry JSON', msg); return null; } }\nif (!d || typeof d !== 'object') return null;\nconst device = d.device || (msg.topic.split('/')[1] || 'unknown');\nmsg.payload = {\n  timestamp: d.ts || Math.floor(Date.now()/1000),\n  device: device,\n  distance_cm: Number(d.distance_cm ?? -1),\n  stock_pct: Number(d.stock_pct ?? -1),\n  bowl_g: Number(d.bowl_g ?? -1),\n  daily_g: Number(d.daily_g ?? 0),\n  rssi: Number(d.rssi ?? 0),\n  samples: Number(d.samples ?? 0),\n  sent: Number(d.sent ?? 0),\n  received_at: new Date()\n};\nflow.set('latestTelemetry', msg.payload);\nreturn msg;",
    "outputs": 1,
    "x": 350,
    "y": 80,
    "wires": [["mongo-telemetry","stock-gauge","weight-gauge","distance-text","daily-text","rssi-text","telemetry-chart","telemetry-debug","low-stock-check"]]
  },
  {
    "id": "mongo-telemetry",
    "type": "mongodb out",
    "z": "tab-smartfeeder",
    "mongodb": "mongo-config",
    "name": "Save Telemetry",
    "collection": "telemetry",
    "payonly": true,
    "upsert": false,
    "multi": false,
    "operation": "insert",
    "x": 610,
    "y": 40,
    "wires": []
  },
  {
    "id": "low-stock-check",
    "type": "switch",
    "z": "tab-smartfeeder",
    "name": "Low Stock <= 20%",
    "property": "payload.stock_pct",
    "propertyType": "msg",
    "rules": [{"t":"lte","v":"20","vt":"num"}],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 610,
    "y": 140,
    "wires": [["low-stock-alert"]]
  },
  {
    "id": "low-stock-alert",
    "type": "function",
    "z": "tab-smartfeeder",
    "name": "Create Low Stock Alert",
    "func": "const p = msg.payload;\nmsg.payload = {\n  device: p.device,\n  stock_pct: p.stock_pct,\n  message: `⚠️ Smart Pet Feeder: stok makanan rendah (${p.stock_pct.toFixed(1)}%).`\n};\nreturn msg;",
    "outputs": 1,
    "x": 850,
    "y": 140,
    "wires": [["alert-debug"]]
  },
  {
    "id": "mqtt-in-event",
    "type": "mqtt in",
    "z": "tab-smartfeeder",
    "name": "Event MQTT",
    "topic": "petfeeder/+/event",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 280,
    "wires": [["parse-event"]]
  },
  {
    "id": "parse-event",
    "type": "function",
    "z": "tab-smartfeeder",
    "name": "Process Event",
    "func": "let d = msg.payload;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { node.error('Invalid event JSON', msg); return null; } }\nif (!d || typeof d !== 'object') return null;\nmsg.payload = {\n  timestamp: d.ts || Math.floor(Date.now()/1000),\n  device: d.device || (msg.topic.split('/')[1] || 'unknown'),\n  type: d.type || 'unknown',\n  status: d.status || 'unknown',\n  target_g: Number(d.target_g ?? 0),\n  delivered_g: Number(d.delivered_g ?? 0),\n  reason: d.reason || '',\n  received_at: new Date()\n};\nflow.set('lastEvent', msg.payload);\nreturn msg;",
    "outputs": 1,
    "x": 350,
    "y": 280,
    "wires": [["mongo-event","event-text","event-debug","event-alert-check"]]
  },
  {
    "id": "mongo-event",
    "type": "mongodb out",
    "z": "tab-smartfeeder",
    "mongodb": "mongo-config",
    "name": "Save Event",
    "collection": "events",
    "payonly": true,
    "upsert": false,
    "multi": false,
    "operation": "insert",
    "x": 610,
    "y": 240,
    "wires": []
  },
  {
    "id": "event-alert-check",
    "type": "switch",
    "z": "tab-smartfeeder",
    "name": "Feed Failed / Rejected",
    "property": "payload.status",
    "propertyType": "msg",
    "rules": [{"t":"regex","v":"^(FAILED|REJECTED)$","vt":"str","case":false}],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 620,
    "y": 320,
    "wires": [["feed-alert"]]
  },
  {
    "id": "feed-alert",
    "type": "function",
    "z": "tab-smartfeeder",
    "name": "Create Feed Alert",
    "func": "const e = msg.payload;\nmsg.payload = {\n  device: e.device,\n  message: `⚠️ Feeding ${e.status}\nTarget: ${e.target_g} g\nDelivered: ${e.delivered_g} g\nReason: ${e.reason}`\n};\nreturn msg;",
    "outputs": 1,
    "x": 850,
    "y": 320,
    "wires": [["alert-debug"]]
  },
  {
    "id": "mqtt-in-status",
    "type": "mqtt in",
    "z": "tab-smartfeeder",
    "name": "Status MQTT",
    "topic": "petfeeder/+/status",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 430,
    "wires": [["process-status"]]
  },
  {
    "id": "process-status",
    "type": "function",
    "z": "tab-smartfeeder",
    "name": "Process Status",
    "func": "let status = msg.payload;\nif (typeof status === 'object') status = status.status || status.state || JSON.stringify(status);\nmsg.payload = { device: msg.topic.split('/')[1] || 'unknown', status: String(status), received_at: new Date() };\nflow.set('deviceStatus', msg.payload);\nreturn msg;",
    "outputs": 1,
    "x": 350,
    "y": 430,
    "wires": [["status-text","status-debug"]]
  },
  {
    "id": "stock-gauge",
    "type": "ui_gauge",
    "z": "tab-smartfeeder",
    "name": "Food Stock",
    "group": "dashboard-group",
    "order": 1,
    "width": 4,
    "height": 4,
    "gtype": "gage",
    "title": "Food Stock",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": ["#d32f2f","#f9a825","#388e3c"],
    "seg1": 20,
    "seg2": 50,
    "x": 850,
    "y": 40,
    "wires": []
  },
  {
    "id": "weight-gauge",
    "type": "ui_gauge",
